<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 1. ГЛАВНОЕ МЕНЮ -->
    <LinearLayout
        android:id="@+id/layoutMainMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:text="🗡️ ГРАФИЧЕСКИЙ\nЛАБИРИНТ СУДЬБЫ 🛡️"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStartMenu"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:background="@drawable/btn_3d_primary"
            android:text="@string/btn_start"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. СОЗДАНИЕ ПЕРСОНАЖА -->
    <LinearLayout
        android:id="@+id/layoutCharCreation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/title_char_creation"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCharName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/hint_char_name"
            android:inputType="textPersonName"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <RadioGroup
            android:id="@+id/rgClasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbWarrior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🛡️ Воин (200 брони, Сила)"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbMage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔮 Маг (Мощная магия)"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbRogue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗡️ Разбойник (25% уклонения)"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnCreateChar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_3d_primary"
            android:text="@string/btn_create"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. ОСНОВНОЙ ГРАФИЧЕСКИЙ ЭКРАН ИГРЫ -->
    <LinearLayout
        android:id="@+id/layoutGameMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ВЕРХНЯЯ ПАНЕЛЬ С ХАРАКТЕРИСТИКАМИИ И ИНДИКАТОРАМИ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Имя (Класс)"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Уровень: 1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ProgressBar
                        android:id="@+id/pbHealth"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="12dp"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/pb_3d_health" />
                    <TextView
                        android:id="@+id/tvHealthStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="100/100 HP"
                        android:textColor="#FF6666"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ProgressBar
                        android:id="@+id/pbMana"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="12dp"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/pb_3d_mana" />
                    <TextView
                        android:id="@+id/tvManaStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="30/30 MP"
                        android:textColor="#66B2FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnOpenTalents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_3d_primary"
                android:paddingHorizontal="12dp"
                android:text="@string/btn_talents"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ЦЕНТРАЛЬНЫЙ 2D Canvas ИГРОВОЙ ЭКРАН С ПАНЕЛЬЮ СПОСОБНОСТЕЙ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- НАШ СОБСТВЕННЫЙ CANVAS VIEW -->
            <com.example.textrpg.GameView
                android:id="@+id/gameView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/layoutAbilityContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnClassAbility"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@drawable/btn_3d_primary"
                    android:padding="2dp"
                    android:text="Раж"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ТЕКСТОВЫЙ ЛОГ И СОБЫТИЯ ПОД canvas -->
        <TextView
            android:id="@+id/tvGameLog"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="Загрузка графического лабиринта..."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- БЛОК КНОПОК ДВИЖЕНИЯ И БОЯ -->
        <LinearLayout
            android:id="@+id/layoutOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />

    </LinearLayout>

</FrameLayout>
